+        } catch (e: Exception) {
+            LogUtils.w(CLASS_NAME, "Could not restore audio mode: ${e.message}")
+        } finally {
+            savedAudioMode = null
+            savedSpeakerphoneOn = null
+            changedCommunicationDevice = false
+        }
+    }
