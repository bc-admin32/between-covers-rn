{
  "cli": {
    "version": ">= 18.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "gradleCommand": ":app:assembleGooglePlayDebug"
      },
      "env": {
        "EXPO_NO_CAPABILITY_SYNC": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "gradleCommand": ":app:assembleGooglePlayRelease"
      },
      "env": {
        "EXPO_NO_CAPABILITY_SYNC": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_NO_CAPABILITY_SYNC": "1"
      }
    },
    "production-ios": {
      "extends": "production",
      "env": {
        "RNIAP_VARIANT": "amazon"
      }
    },
    "production-google": {
      "extends": "production",
      "env": {
        "RNIAP_VARIANT": "play"
      },
      "android": {
        "gradleCommand": ":app:bundleRelease"
      }
    },
    "production-amazon": {
      "extends": "production",
      "env": {
        "RNIAP_VARIANT": "amazon"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleAmazonRelease"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./play-submit-key.json",
        "track": "internal",
        "releaseStatus": "completed"
      },
      "ios": {
        "ascAppId": "6757622557",
        "appleTeamId": "2R4496MTCJ"
      }
    }
  }
}
